# SilopiDijital Veresiye Portal v1 — ortam değişkenleri
#
# KOPYALA:  cp .env.example .env
#
# ─────────────────────────────────────────────────────────────
# ÖNEMLİ: Supabase URL, publishable key ve service_role anahtarı
# BURAYA YAZILMAZ. Bunlar istemci tarafına inmez.
# Anahtarlar /api/veresiye/* sunucu proxy'sinde durur
# (Cloudflare Pages Functions veya Vercel Function).
# ─────────────────────────────────────────────────────────────

# İsteklerin gideceği kök adres.
#
#   BOŞ BIRAK (önerilen)        → aynı köken (same-origin)
#   "/proxy" gibi göreli yol    → yine aynı köken
#
# DIŞ ALAN ADI KABUL EDİLMEZ (https://api.baska.com gibi).
# Dış adres hem oturum belirteçlerini üçüncü tarafa göndermeyi
# hem de CSP'de connect-src istisnası açmayı gerektirir.
# Yanlış değer verilirse uygulama açılmaz ve hata mesajı gösterir.
VITE_API_BASE_URL=

# Arayüzü sahte veriyle çalıştırır. Hiçbir ağ isteği gitmez.
#   true  → demo (gerçek veri YOK, "DEMO" rozeti göster)
#   false → gerçek API
# Production'da DAİMA false.
VITE_DEMO_MODE=false
